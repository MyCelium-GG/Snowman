{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "my.celium.org.snowmen.fabric.SnowmenFabric"
    ],
    "client": [
      "my.celium.org.snowmen.fabric.SnowmenFabricClient"
    ]
  },
  "mixins": [
    "snowmen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_line}",
    "java": ">=${java_version}"
  },
  "recommends": {
    "mycel": ">=${mycel_version}"
  },
  "breaks": {
    "mycel": "<${mycel_version}"
  }
}
